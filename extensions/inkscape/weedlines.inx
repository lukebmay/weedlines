<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
  <name>Weedlines from selection…</name>
  <id>org.lukebmay.weedlines</id>
  <dependency type="executable" location="extensions">weedlines.py</dependency>
  <dependency type="executable" location="extensions">weedlines_dialog.py</dependency>
  <dependency type="executable" location="extensions">stdio_capture.py</dependency>
  <effect implements-custom-gui="true" needs-live-preview="false" show-stderr="false">
    <object-type>all</object-type>
    <effects-menu>
      <submenu name="Weedlines"/>
    </effects-menu>
    <menu-tip>Open Weedlines in a separate window (Inkscape stays usable); then Import last result</menu-tip>
  </effect>
  <script>
    <command location="inx" interpreter="python">weedlines.py</command>
  </script>
</inkscape-extension>
