<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
  <name>Auto generate weedlines…</name>
  <id>org.lukebmay.weedlines</id>
  <dependency type="executable" location="extensions">weedlines.py</dependency>
  <dependency type="executable" location="extensions">weedlines_dialog/__init__.py</dependency>
  <dependency type="executable" location="extensions">weedlines_dialog/geometry_ask.py</dependency>
  <dependency type="executable" location="extensions">weedlines_dialog/inbox.py</dependency>
  <dependency type="executable" location="extensions">weedlines_dialog/preview.py</dependency>
  <dependency type="executable" location="extensions">weedlines_dialog/run_controls.py</dependency>
  <dependency type="executable" location="extensions">weedlines_dialog/form.py</dependency>
  <dependency type="executable" location="extensions">weedlines_dialog/return_line.py</dependency>
  <dependency type="executable" location="extensions">stdio_capture.py</dependency>
  <effect implements-custom-gui="true" needs-live-preview="false" show-stderr="false">
    <object-type>all</object-type>
    <effects-menu>
      <submenu name="Weedlines"/>
    </effects-menu>
    <menu-tip>Open Weedlines in a separate window (Inkscape stays usable); then Reimport last weedlines</menu-tip>
  </effect>
  <script>
    <command location="inx" interpreter="python">weedlines.py</command>
  </script>
</inkscape-extension>
