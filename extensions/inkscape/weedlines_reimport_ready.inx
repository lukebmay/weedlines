<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
  <name>Reimport last ready</name>
  <id>org.lukebmay.weedlines.reimport-ready</id>
  <dependency type="executable" location="extensions">weedlines_import.py</dependency>
  <dependency type="executable" location="extensions">weedlines_job.py</dependency>
  <dependency type="executable" location="extensions">weedlines.py</dependency>
  <dependency type="executable" location="extensions">weedlines_svg.py</dependency>
  <param name="reimport" type="string" gui-hidden="true">ready</param>
  <effect needs-live-preview="false">
    <object-type>all</object-type>
    <effects-menu>
      <submenu name="Weedlines"/>
    </effects-menu>
    <menu-tip>Place the last ready file on a Weedlines corrections layer</menu-tip>
  </effect>
  <script>
    <command location="inx" interpreter="python">weedlines_import.py</command>
  </script>
</inkscape-extension>
